.mh span{color:var(--mut);font-size:13px}
.row{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-top:1px solid var(--bd);width:100%;background:none;border-left:0;border-right:0;border-bottom:0;text-align:left}
.row small{display:block;color:var(--mut);font-size:13px}
.row .k{white-space:nowrap;font-weight:600}
.chips{display:flex;gap:6px;overflow-x:auto;padding:8px 0 4px;margin-top:4px;border-top:1px solid var(--bd)}
.chip{flex:none;background:var(--chip);border:0;border-radius:20px;padding:6px 12px;font-size:13px}
.add{margin-top:6px;width:100%;border:1.5px dashed var(--bd);background:none;border-radius:10px;padding:8px;color:var(--ac);font-weight:600}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:flex-end;justify-content:center;z-index:20}
.sheet{background:var(--card);width:100%;max-width:560px;max-height:88%;overflow:auto;border-radius:20px 20px 0 0;padding:16px 16px calc(20px + env(safe-area-inset-bottom,0px))}
.sheet h2{margin:0 0 10px;font-size:18px}
label{display:block;font-size:13px;color:var(--mut);margin:8px 0 3px}
